# ---------------------------------------------------------------------------
# Production build environment (Netlify / Vercel / any static host)
# ---------------------------------------------------------------------------
# Vite inlines VITE_* variables at BUILD time, so this file is what points the
# deployed frontend at the live backend. It is safe to commit: it contains no
# secrets, only a public API URL.
#
# Do NOT put a trailing space after the value.
# ---------------------------------------------------------------------------
VITE_API_URL=https://civilsite-mitra.onrender.com/api