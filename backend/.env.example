# CivilSiteMitra Backend Environment Variables
#
# PRODUCTION (Render): NODE_ENV=production makes MONGO_URI and JWT_SECRET
# REQUIRED. The app exits immediately with a clear error if either is missing -
# there is no localhost fallback in production.

# Server
# Render sets PORT automatically; leave unset there.
PORT=5000
NODE_ENV=development

# MongoDB  (REQUIRED in production - no default)
MONGO_URI=mongodb://localhost:27017/civilsite-mitra

# JWT  (JWT_SECRET is REQUIRED in production - no default)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# Super Admin (initial setup)
SUPER_ADMIN_EMAIL=admin@civilsitemitra.com
SUPER_ADMIN_PASSWORD=Admin@123456

# Frontend URL (CORS)
# In production set CLIENT_URL to your deployed frontend origin, e.g.
# https://civilsitemitra.netlify.app
# For several allowed origins use CORS_ORIGINS with commas.
# If CLIENT_URL is unset in production, cross-origin requests are refused
# (same-origin deployments do not need it).
CLIENT_URL=http://localhost:5173
# SERVER_URL=https://your-backend.onrender.com
# CORS_ORIGINS=https://a.example.com,https://b.example.com

# Rate limiting
# General API budget per IP (defaults: 15 min window, 2000 requests).
# Raise RATE_LIMIT_MAX if a whole site office shares one public IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000
# Failed credential attempts per window (logins/forgot/reset). Successful logins are not counted.
RATE_LIMIT_AUTH_MAX=20

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# Payment Gateway (if needed in future)
# STRIPE_KEY=
# RAZORPAY_KEY=
