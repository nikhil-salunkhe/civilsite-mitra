# CivilSiteMitra Backend Environment Variables
#
# PRODUCTION (Render): NODE_ENV=production makes MONGO_URI and JWT_SECRET
# REQUIRED. The app exits immediately with a clear error if either is missing -
# there is no localhost fallback in production.

# Server
# Render sets PORT automatically; leave unset there.
PORT=5000
NODE_ENV=development

# MongoDB  (REQUIRED in production - no default)
MONGO_URI=mongodb://localhost:27017/civilsite-mitra

# JWT  (JWT_SECRET is REQUIRED in production - no default)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# Super Admin (initial setup)
SUPER_ADMIN_EMAIL=admin@civilsitemitra.com
SUPER_ADMIN_PASSWORD=Admin@123456

# Frontend URL (CORS)
# In production set CLIENT_URL to your deployed frontend origin, e.g.
# https://civilsitemitra.netlify.app
# For several allowed origins use CORS_ORIGINS with commas.
# If CLIENT_URL is unset in production, cross-origin requests are refused
# (same-origin deployments do not need it).
CLIENT_URL=http://localhost:5173
# SERVER_URL=https://your-backend.onrender.com
# CORS_ORIGINS=https://a.example.com,https://b.example.com

# Rate limiting
# General API budget per IP (defaults: 15 min window, 2000 requests).
# Raise RATE_LIMIT_MAX if a whole site office shares one public IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000
# Failed credential attempts per window (logins/forgot/reset). Successful logins are not counted.
RATE_LIMIT_AUTH_MAX=20

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760
# How many photos may be uploaded in one gallery request.
MAX_FILES_PER_UPLOAD=20
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# ---------------------------------------------------------------------------
# FILE STORAGE
# ---------------------------------------------------------------------------
# local = write to UPLOAD_PATH. Fine for development, but on Render the disk is
#         ephemeral and EVERY uploaded photo/document is lost on redeploy.
# s3   = any S3-compatible bucket. Works for both AWS S3 and Cloudflare R2.
#
# PRODUCTION: set STORAGE_PROVIDER=s3 and fill in the credentials below, then
#   npm install @aws-sdk/client-s3 @aws-sdk/s3-request-presigner
# With s3 selected and no credentials the app refuses to start rather than
# silently falling back to a disk that disappears.
#
# Objects are never public: they are private and handed to the browser through
# short-lived signed URLs (10 minutes) issued only after the ownership check.
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=local

# --- Cloudflare R2 (leave the S3_* names blank if you use R2) ---
# R2 -> Dashboard -> Manage R2 tokens -> Create API token (Object Read & Write)
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_BUCKET_NAME=civilsitemitra-uploads
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_REGION=auto

# --- AWS S3 (leave the R2_* names blank if you use S3) ---
# S3_BUCKET_NAME=civilsitemitra-uploads
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=            # leave blank for AWS; R2 is derived from R2_ACCOUNT_ID

# Vendor branding printed in the footer of every generated PDF report.
# VENDOR_NAME=TechMitra Technology
# VENDOR_PHONE=9764149564
# VENDOR_EMAIL=techmitrofficial@gmail.com
# VENDOR_WEBSITE=www.techmitr.in

# Payment Gateway (if needed in future)
# STRIPE_KEY=
# RAZORPAY_KEY=
